NEXT_PUBLIC_SITE_URL=http://localhost:3000
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_MEASUREMENT_ID=
# Enable Web Push explicitly; notice publication remains available when disabled.
PUSH_ENABLED=false

# Optional Web Push. Public key must match VAPID_PUBLIC_KEY in the Pokedex.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@devfesttriangulo.com.br
